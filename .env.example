# bubblena-fe – environment variables (copy to .env, never commit .env)
# NUXT_PUBLIC_* values are shipped to the browser; everything else stays on the server.

# Backend (bubblena-be)
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
NUXT_API_KEY=                      # = API_KEY in bubblena-be
NUXT_INTERNAL_TOKEN=               # = INTERNAL_TOKEN in bubblena-be (BE -> FE calls, order access tokens)

# Pre-launch visitor gate (HTTP Basic). Remove server/middleware/auth.global.ts to go public.
NUXT_BASIC_USER=
NUXT_BASIC_PASS=
NUXT_BASIC_GATE_SECRET=            # optional; cookie signing key, defaults to a hash of the credentials

# SMTP – contact form
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_CONTACT_RECEIVER=             # info@… (receives contact-form messages, also the From)

# SMTP – order e-mails (confirmation, invoice, shipped, registration)
NUXT_ORDERS_SMTP_USER=
NUXT_ORDERS_SMTP_PASS=
NUXT_CONTACT_ORDERS=               # objednavky@… (From + internal copy)

# Fakturoid (invoicing)
NUXT_FAKTUROID_SLUG=
NUXT_FAKTUROID_CLIENT_ID=
NUXT_FAKTUROID_CLIENT_SECRET=
NUXT_FAKTUROID_USER_AGENT=         # "Bubblena (info@bubblena.cz)"
NUXT_FAKTUROID_SUBJECT_ID=         # optional: id of the recycled subject
NUXT_FAKTUROID_RECYCLED_EMAIL=     # optional: marker e-mail of the recycled subject

# Third parties (public)
NUXT_PUBLIC_SMARTFORM_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_CLIENT_ID=      # empty = Google login hidden

# Bank transfer details shown to customers (public)
NUXT_PUBLIC_BANK_RECIPIENT=Bubblena.cz
NUXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NUXT_PUBLIC_BANK_CODE=
NUXT_PUBLIC_BANK_IBAN=
NUXT_PUBLIC_BANK_BIC=
